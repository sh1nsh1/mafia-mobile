{
  "typeCheckingMode": "standard",
  "include": ["app"],
  "exclude": ["**/__pycache__", ".venv", "**/.*", "**/node_modules"],
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["app"],
  "reportUnusedImport": "warning",
  "reportGeneralTypeIssues": "none",
  "reportCallIssue": "information"
}
